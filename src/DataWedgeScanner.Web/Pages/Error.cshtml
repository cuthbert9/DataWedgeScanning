@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="panel">
    <h2>Something went wrong</h2>
    <p>An unexpected error occurred while handling your request.</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
</section>
